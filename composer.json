{
  "name": "davidrubydev/rez",
  "description": "Rez reservation engine — domain and application layers",
  "type": "library",
  "autoload": {
    "psr-4": {
      "Rez\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rez\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "phpstan/phpstan": "^2",
    "squizlabs/php_codesniffer": "^3",
    "friendsofphp/php-cs-fixer": "^3",
    "infection/infection": "^0.29"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "stan": "vendor/bin/phpstan analyse src tests --level=max",
    "cs": "vendor/bin/phpcs --standard=PSR12 src tests",
    "cs-fix": "PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix --rules=@PSR12 src tests",
    "infection": "vendor/bin/infection --threads=4"
  }
}
